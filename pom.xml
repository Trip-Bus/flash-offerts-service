<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.tripbus</groupId>
    <artifactId>flash-offers-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>flash-offers-service</name>
    <description>Ofertas relámpago de TripBus: creación, contador atómico de cupo, venta sin sobreventa y cupo en vivo</description>

    <properties>
        <java.version>21</java.version>

        <!-- Parches de seguridad (Trivy) más nuevos que los que gestiona Boot 3.5.16, dentro de las
             mismas líneas menores. Quitarlos cuando una Boot 3.5.x posterior ya los traiga. -->
        <jackson-bom.version>2.21.7</jackson-bom.version>
        <netty.version>4.1.137.Final</netty.version>
        <tomcat.version>10.1.60</tomcat.version>
        <postgresql.version>42.7.12</postgresql.version>

        <springdoc.version>2.8.17</springdoc.version>
        <logstash-logback.version>8.0</logstash-logback.version>
        <jacoco.version>0.8.12</jacoco.version>
        <sonar-maven-plugin.version>5.8.0.7211</sonar-maven-plugin.version>

        <!-- Mínimos de cobertura total que exige jacoco:check (ver jacoco-maven-plugin).
             La cobertura nunca puede bajar: si agregas pruebas, sube el mínimo.
             Fijados con la medición del 2026-10-09 redondeada hacia abajo al 5 %: líneas 54-57 % -> 0.50
             (varía entre corridas: OfferScheduler corre en segundo plano según el reloj; en el CI midió 54 %,
             en local 55,4-56,8 %: se toma la más baja para que el control no falle al azar);
             ramas 43,5 % -> 0.40. AMBOS están por debajo del 0.60 de referencia (hoy solo hay pruebas de
             config y la IT del cupo): subirlos con pruebas de controladores, clientes y eventos es la próxima meta. -->
        <jacoco.minimo.lineas>0.50</jacoco.minimo.lineas>
        <jacoco.minimo.ramas>0.40</jacoco.minimo.ramas>

        <!-- SonarQube Cloud: el análisis lo lanza el CI solo en develop (push y PR con base develop)
             cuando existe el secreto SONAR_TOKEN. El plan Free analiza una única rama. -->
        <sonar.organization>trip-bus</sonar.organization>
        <sonar.projectKey>Trip-Bus_flash-offerts-service</sonar.projectKey>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>
        <!-- Fuera de la cobertura solo lo que no tiene lógica que probar (se sigue analizando como código):
             arranque de Spring, records de entrada/salida sin métodos, entidades JPA de solo
             constructor/getters y la definición del documento OpenAPI. Se quedan DENTRO porque tienen
             lógica: domain/Offer (vigente, activar, asignarAsientos...), domain/OfferSale (vender,
             liberar, viva), common/error/ErrorResponse (métodos of) y common/events/EventProperties
             (normaliza valores por defecto). MISMA lista en <excludes> de jacoco-maven-plugin (formato .class). -->
        <sonar.coverage.exclusions>
            **/FlashOffersApplication.java,
            **/web/dto/CreateOfferRequest.java,
            **/web/dto/OfferResponse.java,
            **/web/dto/QuotaResponse.java,
            **/web/dto/ReservationResponse.java,
            **/web/dto/ReserveRequest.java,
            **/common/events/EventEnvelope.java,
            **/common/events/ProcessedEvent.java,
            **/config/OpenApiConfig.java
        </sonar.coverage.exclusions>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Swagger UI / OpenAPI (solo IDE y QA; apagado en application-prod.yml). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Logs en JSON en PROD (logback-spring.xml). -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-logback.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Pruebas de integración contra PostgreSQL y Redis reales (FlashOfferQuotaIT, Testcontainers). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!-- Versión fija del scanner que invoca el CI (mvn ... sonar-maven-plugin:sonar). -->
                <plugin>
                    <groupId>org.sonarsource.scanner.maven</groupId>
                    <artifactId>sonar-maven-plugin</artifactId>
                    <version>${sonar-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!-- META-INF/build-info.properties: versión y fecha en /actuator/info. -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Unitarias (*Test, *Tests) e integración (*IT, Testcontainers: requiere Docker). -->
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>

            <!-- Cobertura: target/site/jacoco/index.html (y jacoco.xml para Sonar).
                 Además jacoco:check (fase verify) corre en TODAS las ramas, también en main donde no
                 corre Sonar: rompe el build si la cobertura total baja de jacoco.minimo.lineas/ramas.
                 La cobertura nunca puede bajar: si agregas pruebas, sube el mínimo. -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <configuration>
                    <!-- Mismas exclusiones que sonar.coverage.exclusions, para que el % coincida. -->
                    <excludes>
                        <exclude>**/FlashOffersApplication.class</exclude>
                        <exclude>**/web/dto/CreateOfferRequest.class</exclude>
                        <exclude>**/web/dto/OfferResponse.class</exclude>
                        <exclude>**/web/dto/QuotaResponse.class</exclude>
                        <exclude>**/web/dto/ReservationResponse.class</exclude>
                        <exclude>**/web/dto/ReserveRequest.class</exclude>
                        <exclude>**/common/events/EventEnvelope.class</exclude>
                        <exclude>**/common/events/ProcessedEvent.class</exclude>
                        <exclude>**/config/OpenApiConfig.class</exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimo.lineas}</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>${jacoco.minimo.ramas}</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
