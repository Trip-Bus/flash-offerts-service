# Variables de flash-offers-service con valores de QA LOCAL (no son secretos reales).
# Uso: cp .env.example .env   (el .env nunca se sube a git). En PROD los secretos viven solo en el servidor.

# --- Servicio ---
SERVER_PORT=18006

# --- PostgreSQL propia de flash-offers (en Docker el compose cambia host/puerto a offers-db:5432) ---
DB_HOST=localhost
DB_PORT=18106
DB_NAME=tripbus_offers
DB_USERNAME=offers
DB_PASSWORD=offers_qa_pw

# --- Redis compartido, con contraseña (en Docker: redis:6379). Guarda el contador de cupo. ---
REDIS_HOST=localhost
REDIS_PORT=18100
REDIS_PASSWORD=tripbus_redis_qa_pw

# --- Token entre servicios (/internal/** y llamadas a seat-inventory) ---
INTERNAL_API_TOKEN=tripbus_internal_qa_token

# --- Otros servicios (en Docker el compose los cambia a host.docker.internal) ---
IDENTITY_JWKS_URI=http://localhost:18001/.well-known/jwks.json
SEAT_INVENTORY_URL=http://localhost:18003
CATALOG_URL=http://localhost:18002
